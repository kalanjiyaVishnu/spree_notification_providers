<% scope = 'spree_notification_providers.admin.deliveries' %>
<% content_for :page_title do %>
  <%= t("#{scope}.show_title", ref: @message_ref.first(8)) %>
<% end %>

<% content_for :page_actions do %>
  <%= link_to t("#{scope}.back"), spree.admin_notification_deliveries_path, class: 'btn btn-light' %>
<% end %>

<div class="card mb-6">
  <div class="card-body grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
    <div><div class="text-gray-500"><%= t("#{scope}.columns.channel") %></div><%= notification_channel_label(@first.channel) %></div>
    <div><div class="text-gray-500"><%= t("#{scope}.columns.type") %></div><%= SpreeNotificationProviders.message_type(@first.message_type)&.label || @first.message_type %></div>
    <div><div class="text-gray-500"><%= t("#{scope}.columns.time") %></div><%= l(@first.created_at, format: :long) %></div>
    <div>
      <div class="text-gray-500"><%= t("#{scope}.columns.source") %></div>
      <%= @first.source_type ? "#{@first.source_type.demodulize} #{@first.source.try(:number) || @first.source_id}" : '—' %>
    </div>
  </div>
</div>

<div class="card-lg">
  <table class="table">
    <thead>
      <tr>
        <th scope="col"><%= t("#{scope}.columns.attempt") %></th>
        <th scope="col"><%= t("#{scope}.columns.recipient") %></th>
        <th scope="col"><%= t("#{scope}.columns.provider") %></th>
        <th scope="col"><%= t("#{scope}.columns.outcome") %></th>
        <th scope="col"><%= t("#{scope}.columns.reason") %></th>
        <th scope="col"><%= t("#{scope}.columns.time") %></th>
      </tr>
    </thead>
    <tbody>
      <% @deliveries.each do |delivery| %>
        <tr id="<%= delivery.prefixed_id %>">
          <td><%= delivery.attempt_number %></td>
          <td class="font-mono text-sm"><%= mask_recipient(delivery.recipient) %></td>
          <td><%= SpreeNotificationProviders.provider(delivery.provider_key)&.label || delivery.provider_key || '—' %></td>
          <td><%= notification_status_badge(delivery.outcome) %></td>
          <td class="text-xs text-gray-600"><%= delivery.reason %></td>
          <td class="text-sm whitespace-nowrap"><%= l(delivery.created_at, format: :short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="flex justify-between p-4">
    <%= link_to '← ' + Spree.t(:previous), url_for(request.query_parameters.merge(page: @pagy.previous)), class: 'btn btn-light btn-sm' if @pagy.previous %>
    <span></span>
    <%= link_to Spree.t(:next) + ' →', url_for(request.query_parameters.merge(page: @pagy.next)), class: 'btn btn-light btn-sm' if @pagy.next %>
  </div>
</div>
